<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="320.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SoftwareII.Controller.AppointmentByCustomerCountryReport">
   <children>
      <VBox prefHeight="320.0" prefWidth="500.0">
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="32.0" prefWidth="500.0" text="%countryAppt" textAlignment="CENTER">
               <font>
                  <Font name="Georgia Bold" size="28.0" />
               </font>
               <VBox.margin>
                  <Insets top="12.0" />
               </VBox.margin>
            </Label>
            <HBox prefHeight="193.0" prefWidth="600.0">
               <VBox.margin>
                  <Insets top="25.0" />
               </VBox.margin>
               <children>
                  <VBox prefHeight="194.0" prefWidth="229.0">
                     <children>
                        <Label prefHeight="18.0" prefWidth="137.0" text="%selectCountry2">
                           <VBox.margin>
                              <Insets left="35.0" top="50.0" />
                           </VBox.margin>
                        </Label>
                        <ComboBox fx:id="countryCB" onAction="#onClickCountryCB" prefHeight="30.0" prefWidth="150.0">
                           <VBox.margin>
                              <Insets left="50.0" top="7.0" />
                           </VBox.margin>
                        </ComboBox>
                     </children>
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </VBox>
                  <ListView fx:id="countryList" prefHeight="194.0" prefWidth="266.0">
                     <HBox.margin>
                        <Insets left="10.0" right="15.0" />
                     </HBox.margin>
                  </ListView>
               </children>
            </HBox>
            <HBox prefHeight="40.0" prefWidth="500.0">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
               <children>
                  <Button fx:id="clearButton" mnemonicParsing="false" onAction="#onClickClear" prefHeight="30.0" prefWidth="100.0" text="%clear">
                     <HBox.margin>
                        <Insets left="250.0" top="5.0" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="returnButton" mnemonicParsing="false" onAction="#onClickReturn" prefHeight="30.0" prefWidth="100.0" text="%return">
                     <HBox.margin>
                        <Insets left="15.0" top="5.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
         </children></VBox>
   </children>
</AnchorPane>
