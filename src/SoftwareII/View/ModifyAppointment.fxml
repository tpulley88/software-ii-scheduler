<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SoftwareII.Controller.ModifyAppointment">
   <children>
      <VBox prefHeight="500.0" prefWidth="600.0">
         <children>
            <Label alignment="CENTER" prefHeight="30.0" prefWidth="600.0" text="%modifyAppt">
               <font>
                  <Font name="Georgia Bold" size="28.0" />
               </font>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin></Label>
            <HBox prefHeight="362.0" prefWidth="600.0">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <children>
                  <GridPane hgap="10.0" maxHeight="-Infinity" prefHeight="351.0" prefWidth="336.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="97.4" minWidth="10.0" prefWidth="97.4" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="230.0" minWidth="10.0" prefWidth="203.4" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints maxHeight="-Infinity" minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
                      <RowConstraints maxHeight="-Infinity" minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
                      <RowConstraints maxHeight="60.0" minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
                        <RowConstraints maxHeight="-Infinity" minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
                        <RowConstraints maxHeight="-Infinity" minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
                        <RowConstraints maxHeight="-Infinity" minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
                        <RowConstraints maxHeight="-Infinity" minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <HBox.margin>
                        <Insets bottom="5.0" left="10.0" right="10.0" top="15.0" />
                     </HBox.margin>
                     <children>
                        <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="126.0" text="%apptID" textAlignment="CENTER">
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font></Label>
                        <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="129.0" text="%title" GridPane.rowIndex="1">
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font></Label>
                        <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="112.0" text="Description" GridPane.rowIndex="2">
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font></Label>
                        <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="104.0" text="%location2" GridPane.rowIndex="3">
                           <GridPane.margin>
                              <Insets />
                           </GridPane.margin>
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font></Label>
                        <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="120.0" text="Contact" GridPane.rowIndex="4">
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font></Label>
                        <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="133.0" text="%type" GridPane.rowIndex="5">
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font></Label>
                        <TextField fx:id="apptID" editable="false" maxWidth="-Infinity" minWidth="-Infinity" prefHeight="26.0" prefWidth="51.0" promptText="-Auto-" GridPane.columnIndex="1" />
                        <TextField fx:id="apptTitle" prefHeight="26.0" prefWidth="198.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                           <GridPane.margin>
                              <Insets bottom="5.0" />
                           </GridPane.margin></TextField>
                        <TextField fx:id="description" prefHeight="55.0" prefWidth="186.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                           <GridPane.margin>
                              <Insets bottom="5.0" />
                           </GridPane.margin></TextField>
                        <TextField fx:id="apptLocation" layoutX="118.0" layoutY="55.0" prefHeight="26.0" prefWidth="198.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <ComboBox fx:id="contactCB" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                        <TextField fx:id="apptType" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                        <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="109.0" text="%customerID" textAlignment="CENTER" GridPane.rowIndex="6">
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font>
                        </Label>
                        <ComboBox fx:id="custIDCB" prefWidth="142.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                     </children>
                  </GridPane>
                  <VBox prefHeight="362.0" prefWidth="270.0">
                     <children>
                        <Label alignment="CENTER" prefHeight="26.0" prefWidth="248.0" text="%apptTime" textAlignment="CENTER">
                           <VBox.margin>
                              <Insets left="10.0" right="10.0" top="30.0" />
                           </VBox.margin>
                           <font>
                              <Font name="Georgia" size="16.0" />
                           </font>
                        </Label>
                        <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="86.0" text="%startDate" textAlignment="CENTER">
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font>
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Label>
                        <DatePicker fx:id="startDate" onAction="#onClickStartDate">
                           <VBox.margin>
                              <Insets left="50.0" top="5.0" />
                           </VBox.margin>
                        </DatePicker>
                        <Label alignment="CENTER_RIGHT" layoutX="10.0" layoutY="117.0" prefHeight="18.0" prefWidth="86.0" text="%startTime" textAlignment="CENTER">
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font>
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                        </Label>
                        <ComboBox fx:id="startTime" onAction="#onClickStartTime" onShowing="#onShowLoadNewStartTimes" prefWidth="100.0">
                           <VBox.margin>
                              <Insets left="50.0" top="5.0" />
                           </VBox.margin>
                        </ComboBox>
                        <Label alignment="CENTER_RIGHT" layoutX="10.0" layoutY="117.0" prefHeight="18.0" prefWidth="86.0" text="%endDate" textAlignment="CENTER">
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font>
                           <VBox.margin>
                              <Insets top="15.0" />
                           </VBox.margin>
                        </Label>
                        <DatePicker fx:id="endDate" layoutX="60.0" layoutY="140.0" onAction="#onClickEndDate">
                           <VBox.margin>
                              <Insets left="50.0" top="5.0" />
                           </VBox.margin>
                        </DatePicker>
                        <Label alignment="CENTER_RIGHT" layoutX="10.0" layoutY="176.0" prefHeight="18.0" prefWidth="86.0" text="%endTime" textAlignment="CENTER">
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font>
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                        </Label>
                        <ComboBox fx:id="endTime" onAction="#onClickEndTime" onShowing="#onShowLoadNewEndTime" prefWidth="100.0">
                           <VBox.margin>
                              <Insets left="50.0" top="5.0" />
                           </VBox.margin>
                        </ComboBox>
                        <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="88.0" text="%userID" textAlignment="CENTER">
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font>
                           <VBox.margin>
                              <Insets top="20.0" />
                           </VBox.margin>
                        </Label>
                        <Label fx:id="usernameLabel" alignment="CENTER" contentDisplay="CENTER" prefHeight="18.0" prefWidth="136.0">
                           <font>
                              <Font name="Georgia Italic" size="12.0" />
                           </font>
                           <VBox.margin>
                              <Insets left="50.0" />
                           </VBox.margin>
                        </Label>
                     </children></VBox>
               </children></HBox>
            <HBox prefHeight="0.0" prefWidth="600.0" />
            <HBox prefHeight="73.0" prefWidth="600.0">
               <children>
                  <Button fx:id="saveButton" mnemonicParsing="false" onAction="#onClickSave" prefHeight="30.0" prefWidth="131.0" text="%saveAppointment">
                     <HBox.margin>
                        <Insets left="200.0" top="15.0" />
                     </HBox.margin></Button>
                  <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#onClickCancel" prefHeight="30.0" prefWidth="100.0" text="%cancel">
                     <HBox.margin>
                        <Insets left="15.0" top="15.0" />
                     </HBox.margin>
                     <font>
                        <Font name="Georgia" size="12.0" />
                     </font></Button>
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin></HBox>
         </children></VBox>
   </children>
</AnchorPane>
