<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SoftwareII.Controller.AddCustomer">
   <children>
      <VBox prefHeight="400.0" prefWidth="600.0">
         <children>
            <Label alignment="CENTER" prefHeight="30.0" prefWidth="600.0" text="%addCust">
               <font>
                  <Font name="Georgia Bold" size="28.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin></Label>
            <HBox prefHeight="300.0" prefWidth="600.0">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
               <children>
                  <GridPane hgap="10.0" prefHeight="282.0" prefWidth="336.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="97.4" minWidth="10.0" prefWidth="97.4" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="230.0" minWidth="10.0" prefWidth="203.4" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints maxHeight="56.39999999999999" minHeight="10.0" prefHeight="56.39999999999999" vgrow="SOMETIMES" />
                        <RowConstraints maxHeight="37.400000000000006" minHeight="10.0" prefHeight="28.400000000000006" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <HBox.margin>
                        <Insets bottom="5.0" left="10.0" right="10.0" />
                     </HBox.margin>
                     <children>
                        <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="126.0" text="%IDNumber" textAlignment="CENTER">
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font></Label>
                        <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="129.0" text="%Name" GridPane.rowIndex="1">
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font></Label>
                        <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="112.0" text="%Address" GridPane.rowIndex="2">
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font></Label>
                        <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="104.0" text="%Country" GridPane.rowIndex="3">
                           <GridPane.margin>
                              <Insets />
                           </GridPane.margin>
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font></Label>
                        <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="120.0" text="%StateProvince" GridPane.rowIndex="4">
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font></Label>
                        <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="133.0" text="%ZipPostalCode" GridPane.rowIndex="5">
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font></Label>
                        <Label alignment="CENTER_RIGHT" prefHeight="18.0" prefWidth="129.0" text="%PhoneNumber" GridPane.rowIndex="6">
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font></Label>
                        <TextField fx:id="custID" editable="false" maxWidth="-Infinity" minWidth="-Infinity" prefHeight="26.0" prefWidth="51.0" promptText="-Auto-" GridPane.columnIndex="1" />
                        <TextField fx:id="custName" prefHeight="26.0" prefWidth="198.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <TextField fx:id="custAddress" prefHeight="55.0" prefWidth="186.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <ComboBox fx:id="custCountryCB" onAction="#onClickCountryCB" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <ComboBox fx:id="custDivCB" onShown="#shownDivCB" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                        <TextField fx:id="custZip" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                        <TextField fx:id="custPhone" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                     </children>
                  </GridPane>
                  <VBox prefHeight="287.0" prefWidth="242.0">
                     <children>
                        <Label alignment="CENTER" prefHeight="26.0" prefWidth="248.0" text="%apptTime" textAlignment="CENTER">
                           <VBox.margin>
                              <Insets left="10.0" right="10.0" top="70.0" />
                           </VBox.margin>
                           <font>
                              <Font name="Georgia" size="16.0" />
                           </font>
                        </Label>
                        <ListView fx:id="custApptBox" disable="true" prefHeight="101.0" prefWidth="222.0">
                           <VBox.margin>
                              <Insets left="10.0" right="10.0" />
                           </VBox.margin>
                        </ListView>
                        <Button fx:id="manageButton" mnemonicParsing="false" onAction="#onClickManage" prefHeight="30.0" prefWidth="148.0" text="%manageAppt">
                           <VBox.margin>
                              <Insets left="50.0" top="10.0" />
                           </VBox.margin>
                           <font>
                              <Font name="Georgia" size="12.0" />
                           </font>
                        </Button>
                     </children></VBox>
               </children></HBox>
            <HBox prefHeight="73.0" prefWidth="600.0">
               <children>
                  <Button fx:id="saveButton" mnemonicParsing="false" onAction="#onClickSave" prefHeight="30.0" prefWidth="100.0" text="%saveCustomer">
                     <HBox.margin>
                        <Insets left="270.0" top="15.0" />
                     </HBox.margin></Button>
                  <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#onClickCancel" prefHeight="30.0" prefWidth="100.0" text="%cancel">
                     <HBox.margin>
                        <Insets left="15.0" top="15.0" />
                     </HBox.margin>
                     <font>
                        <Font name="Georgia" size="12.0" />
                     </font></Button>
               </children></HBox>
         </children></VBox>
   </children>
</AnchorPane>
