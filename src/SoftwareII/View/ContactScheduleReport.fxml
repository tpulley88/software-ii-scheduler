<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SoftwareII.Controller.ContactScheduleReport">
   <children>
      <VBox prefHeight="400.0" prefWidth="800.0">
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="71.0" prefWidth="800.0" text="%contSchedule" textAlignment="CENTER">
               <font>
                  <Font name="Georgia Bold" size="30.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Label>
            <HBox prefHeight="41.0" prefWidth="800.0">
               <children>
                  <Label alignment="CENTER_RIGHT" contentDisplay="CENTER" prefHeight="16.0" prefWidth="210.0" text="%chooseContact">
                     <font>
                        <Font name="Georgia" size="14.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="15.0" top="10.0" />
                     </HBox.margin></Label>
                  <ComboBox fx:id="contactCB" onAction="#onClickContactCB" prefWidth="150.0">
                     <HBox.margin>
                        <Insets left="10.0" top="7.0" />
                     </HBox.margin></ComboBox>
               </children>
            </HBox>
            <TableView fx:id="contactTV" prefHeight="200.0" prefWidth="200.0">
              <columns>
                <TableColumn fx:id="apptID" prefWidth="100.0" text="%apptID" />
                <TableColumn fx:id="apptTitle" prefWidth="120.0" text="%title" />
                  <TableColumn fx:id="apptType" prefWidth="110.0" text="%type" />
                  <TableColumn fx:id="apptDesc" prefWidth="135.0" text="Description" />
                  <TableColumn fx:id="startDT" prefWidth="105.0" text="%startDateTime" />
                  <TableColumn fx:id="endDT" prefWidth="105.0" text="%endDateTime" />
                  <TableColumn fx:id="custID" prefWidth="95.0" text="%customerID" />
              </columns>
               <VBox.margin>
                  <Insets left="15.0" right="15.0" top="10.0" />
               </VBox.margin>
            </TableView>
            <Button fx:id="apptDash" mnemonicParsing="false" onAction="#onClickApptDash" prefHeight="30.0" prefWidth="200.0" text="%apptDashboard">
               <font>
                  <Font name="Georgia" size="16.0" />
               </font>
               <VBox.margin>
                  <Insets left="575.0" top="20.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>
